{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Async",
  "version": "0.1.0",
  "identifier": "dev.async.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "label": "main", "title": "Async", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 640 }], "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https:; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'" } },
  "bundle": { "active": true, "targets": "all" }
}
